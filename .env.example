# Optional: leave empty for manual import and the offline demo.
GEMINI_API_KEY=
# Set true only after checking that billing is disabled for your project.
GEMINI_FREE_TIER_CONFIRMED=false
# Conservative local guardrail below the observed 500 RPD free-tier limit for Gemini 3.1 Flash Lite.
GEMINI_DAILY_CALL_LIMIT=450
# Optional override. No automatic model fallback or paid upgrade.
GEMINI_MODEL=gemini-3.1-flash-lite
# Default: apps/api/storage. Use an absolute path on a persistent local disk.
# KNOWLEDGE_ENGINE_STORAGE=/absolute/path/to/private/storage

# Persistence mode (read once at startup): local is the default when unset.
# Only exact local|hosted values are accepted.
# KNOWLEDGE_ENGINE_PERSISTENCE_MODE=local

# Hosted StateStore requires both variables; supply private values externally.
# KNOWLEDGE_ENGINE_DATABASE_URL=
# KNOWLEDGE_ENGINE_WORKSPACE_KEY=

# Hosted private Storage (server only; required in hosted mode).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# KNOWLEDGE_ENGINE_STORAGE_BUCKET=knowledge-engine-artifacts
# Workspace key above must be a single segment: letters, digits, underscores, hyphens.

# Shared private beta gate (required only in hosted mode; server-side values only).
# Use a long private password and a separately generated random session secret.
# KNOWLEDGE_ENGINE_BETA_PASSWORD=
# Generate SESSION_SECRET with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# KNOWLEDGE_ENGINE_SESSION_SECRET=

# Hosted HTTPS hostname only: no scheme, path, port, wildcard, or host list.
# KNOWLEDGE_ENGINE_PUBLIC_HOST=your-service.onrender.com
# Render provides PORT automatically; local scripts retain their current defaults.
# First hosted deployment: leave GEMINI_API_KEY unset and free-tier confirmation false.
